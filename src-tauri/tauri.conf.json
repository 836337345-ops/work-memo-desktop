{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "工作备忘录", "version": "0.1.0", "identifier": "com.local.workmemo",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://127.0.0.1:1460", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "label": "main", "title": "工作备忘录", "width": 1440, "height": 920, "minWidth": 1060, "minHeight": 700 }], "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'" } },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"], "shortDescription": "本地工作事项与进度管理", "windows": { "nsis": { "languages": ["SimpChinese"], "displayLanguageSelector": false, "installMode": "currentUser" }, "webviewInstallMode": { "type": "downloadBootstrapper" } } }
}
