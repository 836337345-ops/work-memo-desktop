#!/bin/sh

# Reuse the verified local dependencies when a worktree is created by Git.
# Codex managed worktrees should call the same script through Local environments.
[ "$3" = "1" ] || exit 0

worktree_unix="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$worktree_unix" || exit 0
WORK_MEMO_WORKTREE_ROOT="$(pwd -W 2>/dev/null)" || exit 0

powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass \
  -File "$WORK_MEMO_WORKTREE_ROOT\scripts\setup-codex-worktree.ps1" \
  >/dev/null 2>&1 || exit 0

exit 0
